# Server Configuration
PORT=5001
NODE_ENV=development

# Client URL
CLIENT_URL=http://localhost:5173

# Render keepalive (optional; enabled by default in production)
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_URL=https://your-service-name.onrender.com
# KEEP_ALIVE_PATH=/health
# KEEP_ALIVE_INTERVAL_MS=720000
# KEEP_ALIVE_TIMEOUT_MS=15000

# MongoDB Configuration
# MONGODB_URI=mongodb://localhost:27017/glo

# JWT Configuration
JWT_SECRET=
JWT_EXPIRE=7d

# Telegram Mini App Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_MINI_APP_URL=https://t.me/your_bot_username?startapp=dashboard

# Email Configuration (Brevo SMTP recommended for production)
# Create an SMTP key in Brevo and set these values in Render. Do not commit real secrets.
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_REQUIRE_TLS=true
EMAIL_USER=your-brevo-smtp-login
EMAIL_PASS=your-brevo-smtp-key
EMAIL_FROM=support@yourdomain.com
EMAIL_FROM_NAME=Logszone

# Optional Resend API fallback. Takes priority over SMTP when set.
# RESEND_API_KEY=

# Optional Gmail SMTP fallback.
# EMAIL_SERVICE=gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_REQUIRE_TLS=true
# EMAIL_USER=your-gmail-address@gmail.com
# EMAIL_PASS=your-google-app-password

# Cloudinary Configuration

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# npm run migrate-data "mongouri"

# npm run create-admin
